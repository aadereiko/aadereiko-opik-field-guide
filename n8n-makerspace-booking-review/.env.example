# The scripts read the repo-root .env (they walk up from this folder), so this file only lists what they use.

# OpenAI key for the review node. setup.sh turns it into an n8n credential inside the container;
# it is never written into the workflow file. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Opik. For a local install (https://www.comet.com/docs/opik/self-host/local_deployment) keep these two;
# setup.sh rewrites localhost to host.docker.internal so the container can reach it.
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# For Opik Cloud instead: remove OPIK_URL_OVERRIDE, set your workspace, and add your API key
# (https://www.comet.com/opik, then your profile, then API keys).
# OPIK_API_KEY=

# Optional: host port for the n8n UI and webhook (default 5678).
# N8N_HOST_PORT=5678
