{
  "name": "openai-ts-appliance-manual-qa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Appliance manual Q&A that must quote the manual verbatim",
  "scripts": {
    "demo": "tsx src/main.ts",
    "ask": "tsx src/ask.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "18.0.10",
    "openai": "7.65.0",
    "opik": "2.3.4",
    "opik-openai": "2.3.4"
  },
  "devDependencies": {
    "@types/node": "26.6.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "overrides": {
    "opik-openai": {
      "opik": "$opik"
    }
  }
}
