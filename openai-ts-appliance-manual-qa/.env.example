# Copy to .env here, or put these in a .env at the repo root (the app walks up to find one).
OPENAI_API_KEY=

# Local self-hosted Opik. Opik Cloud users: set OPIK_API_KEY and drop OPIK_URL_OVERRIDE.
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
OPIK_PROJECT_NAME=openai-ts-appliance-manual-qa
