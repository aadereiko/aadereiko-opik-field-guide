title: Add retry with backoff to the parcel-tracking client
--- a/tracking/client.py
+++ b/tracking/client.py
@@ -12,11 +12,22 @@ class TrackingClient:
     def __init__(self, base_url: str, token: str):
         self.base_url = base_url
         self.token = token
+        self.max_attempts = 5
 
     def fetch_status(self, parcel_id: str) -> dict:
-        resp = requests.get(f"{self.base_url}/parcels/{parcel_id}", headers=self._headers())
-        resp.raise_for_status()
-        return resp.json()
+        attempt = 0
+        while True:
+            attempt += 1
+            try:
+                resp = requests.get(f"{self.base_url}/parcels/{parcel_id}", headers=self._headers())
+                resp.raise_for_status()
+                return resp.json()
+            except requests.RequestException:
+                if attempt >= self.max_attempts:
+                    raise
+                time.sleep(attempt)
