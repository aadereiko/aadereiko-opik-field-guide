# Copy this file to .env at the repo root. Every example walks up from its folder to find it.

# --- Opik ---
# Local self-hosted Opik (https://www.comet.com/docs/opik/self-host/local_deployment). No API key needed.
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# For Opik Cloud instead: remove OPIK_URL_OVERRIDE, set OPIK_WORKSPACE to your workspace and add your key
# (https://www.comet.com/opik, then your profile, then API keys).
# OPIK_API_KEY=

# --- LLM provider ---
# Used by every example: https://platform.openai.com/api-keys
OPENAI_API_KEY=
