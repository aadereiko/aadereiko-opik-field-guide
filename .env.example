# Copy this file to .env at the repo root. Every example reads the root .env.

# --- Opik ---
# Local self-hosted Opik (https://www.comet.com/docs/opik/self-host/local_deployment)
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# Only needed for Opik Cloud; leave unset for a local install.
# OPIK_API_KEY=

# --- LLM providers ---
# Needed by most examples: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional, for examples that call Claude: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
